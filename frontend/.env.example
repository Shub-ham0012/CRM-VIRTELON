# Copy to .env and fill in real values. Never commit the real .env file.
# This value is public and baked into the build at compile time
# (CRA env vars) — do not put secrets in REACT_APP_* variables.

# Base URL of the backend API, WITHOUT a trailing /api
# e.g. http://localhost:8001 for local dev, or https://your-backend-host
REACT_APP_BACKEND_URL=http://localhost:8001
