# Copy to .env and fill in real values. Never commit the real .env file.

# MongoDB connection string (Atlas SRV in production, e.g.
# mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/)
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=virtelon_command_centre

# Reserved for future CORS restriction; not currently read by server.py
# (CORS is allow_origins=["*"] there, which is acceptable because auth is
# Bearer-token based, not cookie based).
CORS_ORIGINS=*

# Long random value used to sign JWT access tokens.
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-value

# Password seeded for the 3 founder accounts on first backend startup.
# Change this from any previous/default value before deploying.
FOUNDER_PASSWORD=change-me-to-a-strong-password

# Claude Sonnet 4.6 access for research/scoring/outreach via
# emergentintegrations. If missing/invalid, the app falls back to a
# built-in heuristic and must not crash.
EMERGENT_LLM_KEY=

# Optional/paid. Leave empty to use free OpenStreetMap + DuckDuckGo lead
# discovery only. Setting this enables Google Places (New) as the first
# provider, with automatic fallback to the free providers on any error.
GOOGLE_PLACES_API_KEY=

# Set to "true" to auto-seed demo/sample data on backend startup (useful
# for a fresh dev/staging environment). Leave unset in production — the
# separate on-demand "Load Demo Data" button (POST /api/leads/find-demo)
# works regardless of this setting.
SEED_DEMO_DATA=
